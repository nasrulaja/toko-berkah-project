<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <!-- Catatan: dulu ada <View> backdrop 280dp di sini sebagai "sesuatu untuk
         diblur" navbar. Navbar tidak memakai blur nyata (pakai gradient), jadi
         view itu cuma menambah satu draw layer penuh layar yang harus dikomposit
         di bawah semua konten. Dihapus. -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_store_header" />

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Liquid glass navbar: mengambang di atas konten (bukan menempel di bawah).
         Geometri mengikuti GlassNavBar HyperOS: pill 56dp, inset 24dp, ikon di
         atas label. Jarak ke bawah (36dp) diurus di dalam view. -->
    <com.tokoberkah.pos.ui.LiquidGlassNavbar
        android:id="@+id/glassNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:lgnAccent="@color/nav_pill"
        app:lgnGlassColor="@color/glass_fill"
        app:lgnActiveColor="@color/navy_soft"
        app:lgnInactiveColor="@color/gray_muted" />
</FrameLayout>
