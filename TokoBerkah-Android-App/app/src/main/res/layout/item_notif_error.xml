<?xml version="1.0" encoding="utf-8"?>
<!-- Notifikasi error merah (barcode tidak ditemukan) + aksi Input Manual -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notifErrorRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_notif_error"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <ImageView
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_error_circle" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notifErrorText"
            style="@style/FontMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/error_dark"
            android:textSize="12sp"
            tools:text="Produk tidak ditemukan! Barcode: 123456789" />

        <TextView
            android:id="@+id/btnInputManual"
            style="@style/FontBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/scan_input_manual"
            android:textColor="@color/error"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
