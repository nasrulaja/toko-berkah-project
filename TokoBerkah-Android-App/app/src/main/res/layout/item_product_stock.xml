<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    android:background="@drawable/bg_card"
    android:elevation="6dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Atas: foto + nama + EAN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_thumb"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/productImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/product_kopi" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/productName"
                style="@style/FontSemiBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                tools:text="Kopi Kapal Api Spesial Mix" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="11dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ean_glyph" />

                <TextView
                    android:id="@+id/productEan"
                    style="@style/FontMono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:letterSpacing="0.02"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="8991001100223" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Badge status -->
    <LinearLayout
        android:id="@+id/badgeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_badge_low"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <View
            android:id="@+id/badgeDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_dot_green"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/badgeIcon"
            android:layout_width="15dp"
            android:layout_height="13dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_warn_small" />

        <TextView
            android:id="@+id/badgeText"
            style="@style/FontBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/stock_status_low"
            android:textColor="@color/warning_badge_text"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Sisa stok total -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_box_stock"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/FontBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stock_total_label"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/stockNumber"
                style="@style/FontExtraBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="36sp"
                tools:text="4" />

            <TextView
                android:id="@+id/stockUnit"
                style="@style/FontBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                tools:text="Renceng" />
        </LinearLayout>
    </LinearLayout>

    <!-- Per lokasi: rak + gudang -->
    <LinearLayout
        android:id="@+id/boxLocations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_box_location"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_loc_shelf" />

            <TextView
                style="@style/FontMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/stock_on_shelf"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/locShelfValue"
                style="@style/FontBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="4 Buah" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_loc_warehouse" />

            <TextView
                style="@style/FontMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/stock_in_warehouse"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/locWarehouseValue"
                style="@style/FontBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="0 Buah" />
        </LinearLayout>
    </LinearLayout>

    <!-- Baris khusus stok habis: terakhir masuk -->
    <LinearLayout
        android:id="@+id/boxLastIncoming"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_box_location"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_clock" />

        <TextView
            android:id="@+id/lastIncomingText"
            style="@style/FontMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            tools:text="Terakhir Masuk: 3 hari lalu" />

        <TextView
            android:id="@+id/urgencyText"
            style="@style/FontBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stock_urgent"
            android:textColor="@color/error"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
