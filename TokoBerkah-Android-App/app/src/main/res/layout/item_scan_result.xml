<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scanCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:elevation="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Thumbnail + badge jumlah -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_thumb_scan"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/scanProductImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/product_indomie" />

        <TextView
            android:id="@+id/scanQtyBadge"
            style="@style/FontBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginStart="-6dp"
            android:layout_marginTop="-6dp"
            android:background="@drawable/bg_plus_badge"
            android:minWidth="20dp"
            android:gravity="center"
            android:paddingStart="5dp"
            android:paddingTop="2dp"
            android:paddingEnd="5dp"
            android:paddingBottom="2dp"
            android:textColor="@color/white"
            android:textSize="10sp"
            tools:text="+1" />
    </FrameLayout>

    <!-- Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/scanEan"
                style="@style/FontMono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="0089686170733" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/scanPrice"
                style="@style/FontBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="Rp 3.500" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/scanProductName"
                style="@style/FontSemiBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="Indomie Goreng Spesial" />

            <!-- Stepper kuantitas -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_stepper"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/btnQtyMinus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_white"
                    android:clickable="true"
                    android:contentDescription="@string/scan_qty_decrease"
                    android:focusable="true"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="1.5dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_minus" />
                </LinearLayout>

                <TextView
                    android:id="@+id/scanQty"
                    style="@style/FontBold"
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    tools:text="3" />

                <LinearLayout
                    android:id="@+id/btnQtyPlus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_blue"
                    android:clickable="true"
                    android:contentDescription="@string/scan_qty_increase"
                    android:focusable="true"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_plus" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
