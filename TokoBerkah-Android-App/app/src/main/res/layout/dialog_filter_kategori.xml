<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog "Filter produk — kategori" (Figma 193:2) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_tag"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_bold"
            android:text="@string/stock_filter_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/stock_filter_subtitle"
            android:textColor="@color/tag_chip_dialog_hint"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/plus_jakarta_bold"
            android:text="@string/stock_filter_kategori"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/stock_filter_hint"
            android:textColor="@color/tag_chip_dialog_hint"
            android:textSize="12sp" />

        <!-- Tag kategori (diisi kode, mengalir wrap) -->
        <LinearLayout
            android:id="@+id/tagContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- Tombol aksi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnReset"
                android:layout_width="119dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_btn_reset"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/plus_jakarta_bold"
                android:gravity="center"
                android:text="@string/stock_filter_reset"
                android:textColor="@color/tag_chip_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnApply"
                android:layout_width="119dp"
                android:layout_height="30dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_btn_apply"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/plus_jakarta_bold"
                android:gravity="center"
                android:text="@string/stock_filter_apply"
                android:textColor="@color/tag_chip_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
