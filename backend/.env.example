# Salin file ini menjadi .env lalu isi nilainya.

# Port server backend
PORT=3000

# Alamat project Supabase (sama dengan js/core/api.js)
SUPABASE_URL=https://ejohssqnhhtaveelmter.supabase.co

# Publishable/anon key — dipakai untuk baca/tulis data (dibatasi Row Level Security)
SUPABASE_ANON_KEY=sb_publishable_PGbNjr7ySv7Mvwh0hGn8Uw_lz7uAGLs

# Service role key — HANYA disimpan di server, untuk login (membaca users.password_hash).
# Ambil dari: Supabase Dashboard -> Project Settings -> API -> service_role
# Bila kosong, endpoint /api/auth/login akan memberi pesan konfigurasi.
SUPABASE_SERVICE_ROLE_KEY=

# Rahasia tanda tangan token JWT (ganti dengan string acak panjang saat produksi)
JWT_SECRET=ganti-dengan-string-acak-panjang
